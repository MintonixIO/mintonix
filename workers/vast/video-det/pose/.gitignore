# Prebuilt INT8 TensorRT engine (456 MB) — not tracked in git.
# Regenerate with download_model.py + export_trt.py on an RTX 5090 (sm_120),
# or supply it at build time; build.sh stages it into worker/ before docker build.
*.engine

# build.sh hardlinks/copies these into worker/ as a build context staging step.
worker/pipeline_decode.py
worker/calibrate_workers.py

# Worker outputs
worker/out/
*.npz
*.json
