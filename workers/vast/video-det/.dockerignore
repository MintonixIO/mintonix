# Keep the product image lean: no research leftovers, caches, or docs.
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.git
**/.gitignore
**/*.md
!ARCHITECTURE.md
!models/README.md

# Export / research / local debug — not needed at runtime.
# CI fetch_models.sh runs on the runner *before* docker build.
tools/
debug.py
pose/export_trt.py
pose/download_model.py
pose/torch_engine.py
detect/tracknet.py

# Local test artifacts
**/sample_local.*

# Do NOT ignore models/ — CI fetches weights into models/ and the Dockerfile
# COPYs them into /app/models. Loose engines/checkpoints outside models/ stay out.
*.engine
*.pt
*.onnx
!models/**
