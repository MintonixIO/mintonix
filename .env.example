# Roboflow API credentials
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# RF-DETR model — runs entirely on Roboflow's hosted serverless API.
# Use a COCO-pretrained alias (resolved to its project/version automatically):
#   Segmentation (returns polygon masks): rfdetr-seg-preview | rfdetr-seg-nano
#     | rfdetr-seg-small | rfdetr-seg-medium | rfdetr-seg-large
#     | rfdetr-seg-xlarge | rfdetr-seg-2xlarge
#   Detection only (no masks): rfdetr-base | rfdetr-nano | rfdetr-small
#     | rfdetr-medium | rfdetr-large | rfdetr-xlarge | rfdetr-2xlarge
# Or set a custom-trained Roboflow model as "your-project/version".
RF_DETR_MODEL_ID=rfdetr-seg-preview

# Only used for custom-trained models ("your-project"); ignored for aliases.
RF_DETR_MODEL_VERSION=1

# Optional: Comma-separated class names to filter (e.g. "person,anushika,keshani")
# If unset, all predictions are returned unfiltered
RF_DETR_FILTER_CLASSES=

# Server port (local testing only)
PORT=8081
