# Public Supabase project URL (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only. Required for BWF catalog pages and /api/bwf/*.
# Never prefix with NEXT_PUBLIC_. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: publishable anon key if you later wire browser Supabase Auth.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
